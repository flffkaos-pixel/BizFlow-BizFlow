# Oracle Cloud 상시 서버 환경변수
# 이 파일을 .env 로 복사하고 값을 채운다.
# cp .env.example .env

# 도메인 (Cloudflare Tunnel에서 설정한 서브도메인)
PUBLIC_DOMAIN=bizflow.example.com

# 데이터베이스
POSTGRES_USER=app_admin
POSTGRES_PASSWORD=change_me_strong_password

# Redis
REDIS_PASSWORD=change_me_redis

# n8n
N8N_USER=admin
N8N_PASSWORD=change_me_n8n

# Dify
DIFY_SECRET_KEY=change_me_dify_32chars

# Cal.com
CAL_SECRET=change_me_cal_32chars
CAL_ENCRYPTION_KEY=change_me_cal_enc_32chars

# Cloudflare Tunnel 토큰 (Cloudflare Zero Trust에서 생성)
CLOUDFLARE_TUNNEL_TOKEN=change_me_cloudflare_token
